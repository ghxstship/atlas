{
  "name": "@xos/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Prettier presets and repository guards for XOS.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./finish-guard": "./src/finish-guard.ts",
    "./tailwind/preset.js": "./tailwind/preset.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

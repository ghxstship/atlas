{
  "name": "@xos/ui-native",
  "version": "0.0.0",
  "private": true,
  "description": "XOS React Native component library for Compass, drawn with the same tokens as packages/ui through the Style Dictionary native build.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "scripts": {
    "generate:theme": "node scripts/generate-theme.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-theme.mjs --check && vitest run --coverage"
  },
  "dependencies": {
    "@xos/icons": "workspace:*",
    "@xos/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.3 || 19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

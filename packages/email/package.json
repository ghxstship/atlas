{
  "name": "@xos/email",
  "version": "0.0.0",
  "private": true,
  "description": "XOS transactional and notification email: React Email templates with copy from @xos/i18n, rendered to semantic HTML and plain text, sent through Resend behind a transport interface.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./messages": "./src/messages.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@xos/i18n": "workspace:*",
    "@xos/tokens": "workspace:*",
    "intl-messageformat": "12.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

{
  "name": "@xos/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Shared test utilities, the design QA audit, Lighthouse CI budgets and the k6 load scripts for Atlas, Gateway, docs and Compass.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./playwright": "./src/playwright.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "design:audit": "node --experimental-strip-types --no-warnings src/design-audit-cli.ts",
    "lighthouse": "node --experimental-strip-types --no-warnings --import ./src/register-ts.mjs src/lighthouse-cli.ts",
    "load:smoke": "sh load/run.sh smoke",
    "budget:js": "node --experimental-strip-types --no-warnings --import ./src/register-ts.mjs src/bundle-budget-cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "@xos/data": "workspace:*",
    "@xos/ia": "workspace:*",
    "@xos/tokens": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

{
  "name": "@xos/icons",
  "version": "0.0.0",
  "private": true,
  "description": "XOS glyph map and icon registry: the Lucide icon for every department, phase and record kind, the record state glyph shapes, and the closed set of icons XOS draws by name.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./glyphs": "./src/glyphs.ts",
    "./names": "./src/names.ts",
    "./sprite.svg": {
      "types": "./src/sprite.d.ts",
      "default": "./src/sprite.generated.svg"
    },
    "./map.json": "./src/map.json"
  },
  "scripts": {
    "generate:registry": "node scripts/generate-registry.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-registry.mjs --check && vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "1.53.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "sideEffects": false
}

{
  "name": "@xos/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "ICU message catalogs for every XOS shell. The only home of user-facing copy.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./extracts": "./src/extracts.generated.ts",
    "./messages/*": "./messages/*"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings scripts/generate-catalogs.ts --check && vitest run",
    "generate:catalogs": "node --experimental-strip-types --no-warnings scripts/generate-catalogs.ts",
    "check:catalogs": "node --experimental-strip-types --no-warnings scripts/generate-catalogs.ts --check",
    "translate": "node --experimental-strip-types --no-warnings scripts/translate.ts translate",
    "translate:review": "node --experimental-strip-types --no-warnings scripts/translate.ts review",
    "translate:all": "node --experimental-strip-types --no-warnings scripts/translate.ts all",
    "translate:glossary": "node --experimental-strip-types --no-warnings scripts/translate.ts glossary",
    "translate:check": "node --experimental-strip-types --no-warnings scripts/translate.ts check",
    "translate:lock": "node --experimental-strip-types --no-warnings scripts/translate.ts lock"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@types/node": "22.20.5",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

{
  "name": "@xos/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server for the XOS public API: read tools and scoped write tools that act with exactly the permissions of the API key.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xos-mcp": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@ghxstship/xos-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

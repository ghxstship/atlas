{
  "name": "@ghxstship/xos-cli",
  "version": "4.0.0",
  "description": "xos: the command line for the XOS public API. Sign in, choose an organization, call any operation, import, export, validate canon codes and test webhooks.",
  "license": "MIT",
  "author": "GHXSTSHIP Industries LLC",
  "homepage": "https://github.com/ghxstship/atlas/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghxstship/atlas.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ghxstship/atlas/issues"
  },
  "keywords": [
    "xos",
    "atlas",
    "cli",
    "api"
  ],
  "type": "module",
  "bin": {
    "xos": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ghxstship/xos-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

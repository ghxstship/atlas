{
  "name": "@xos/platform",
  "version": "0.0.0",
  "private": true,
  "description": "XOS platform services: Stripe billing, signed webhook dispatch, notification dispatch on email, push (Expo) and SMS (Twilio), the SMS webhook, chat translation and inbound mail, with every external client injected. Used by the Edge Functions and Atlas.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./billing": "./src/billing/index.ts",
    "./webhooks": "./src/webhooks/dispatch.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "stripe:setup": "node --experimental-strip-types --no-warnings scripts/stripe-setup.ts",
    "bundle:edge": "node --experimental-strip-types --no-warnings edge/build.ts",
    "bundle:edge:check": "node --experimental-strip-types --no-warnings edge/build.ts --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@xos/email": "workspace:*",
    "@xos/i18n": "workspace:*",
    "@xos/ia": "workspace:*",
    "@xos/schemas": "workspace:*",
    "@xos/tokens": "workspace:*",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

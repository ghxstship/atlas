{
  "name": "@xos/ui",
  "version": "0.0.0",
  "private": true,
  "description": "XOS web component library: React 19 components on Radix, cmdk and TanStack, styled with the token preset.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./preferences": "./src/lib/preferences.ts",
    "./shortcut-targets": "./src/lib/shortcut-targets.ts",
    "./quick-add": "./src/Editing/quickAddCore.ts",
    "./pwa": "./src/pwa/index.ts",
    "./pwa/client": "./src/pwa/client.ts",
    "./pwa/analytics": "./src/pwa/analytics.ts",
    "./pwa/offline-key": "./src/pwa/offline-key.ts",
    "./pwa/browser-push": "./src/pwa/browser-push.tsx",
    "./styles.css": "./src/styles/index.css",
    "./tailwind.config.cjs": "./tailwind.config.cjs",
    "./brand/*": "./src/brand/defaults/*"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-stories.mjs --check && vitest run --coverage",
    "generate:stories": "node scripts/generate-stories.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static --quiet",
    "test:visual": "playwright test -c test/visual/playwright.config.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@tanstack/react-table": "9.2.6",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "@tiptap/y-tiptap": "3.0.9",
    "@visx/group": "4.0.0",
    "@visx/pattern": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "@xos/i18n": "workspace:*",
    "@xos/icons": "workspace:*",
    "@xos/tokens": "workspace:*",
    "chrono-node": "2.10.2",
    "cmdk": "1.1.1",
    "lucide-react": "1.53.0",
    "maplibre-gl": "6.13.0",
    "qrcode-generator": "1.4.4",
    "radix-ui": "1.7.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "stylelint": "16.26.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

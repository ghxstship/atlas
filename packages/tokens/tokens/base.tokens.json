      "mono": {
        "$type": "fontFamily",
        "$value": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
        "$description": "JetBrains Mono (SIL OFL) for URIDs, codes, keys and URNs."
      }

    },
    "sidebar": {
      "$type": "number",
      "$value": 200,
      "$description": "Sidebar."
    },
    "header": {
      "$type": "number",
      "$value": 300,
      "$description": "App header."
    },
    "dropdown": {
      "$type": "number",
      "$value": 1000,
      "$description": "Dropdown menus."
    },
    "popover": {
      "$type": "number",
      "$value": 1100,
      "$description": "Popovers and hover cards."
    },
    "peek": {
      "$type": "number",
      "$value": 1200,
      "$description": "Side peek and drawers."
    },
    "dialog": {
      "$type": "number",
      "$value": 1300,
      "$description": "Dialogs."
    },
    "command": {
      "$type": "number",
      "$value": 1400,
      "$description": "Command menu."
    },
    "toast": {
      "$type": "number",
      "$value": 1500,
      "$description": "Toasts."
    },
    "tooltip": {
      "$type": "number",
      "$value": 1600,
      "$description": "Tooltips."
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",

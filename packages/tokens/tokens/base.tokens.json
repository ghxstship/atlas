    "auth": {
      "$type": "dimension",
      "$value": "400px",
      "$description": "Auth card width."
    },
    "form": {
      "$type": "dimension",
      "$value": "640px",
      "$description": "Settings and form column."
    },
    "reading": {
      "$type": "dimension",
      "$value": "720px",
      "$description": "Document reading column."
    },
    "wide": {
      "$type": "dimension",
      "$value": "1200px",
      "$description": "Wide content."
    },
    "columns": {
      "$type": "number",
      "$value": 12,
      "$description": "Dashboard and page grid columns."

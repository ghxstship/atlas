      "$type": "dimension",
      "$value": "48px",
      "$description": "Compass minimum touch target (48 pt)."
    },
    "target-fine": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Minimum target on a fine pointer (WCAG 2.2 SC 2.5.8 AA). Every web control meets it at control-sm and up."
    },
    "target-coarse": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Minimum target on a coarse pointer (touch) for Atlas and Gateway on phones and tablets (WCAG 2.2 SC 2.5.5 AAA). Compass uses touch-min."
    }
  },
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms",
        "$description": "State changes with no movement."
      },
      "fast": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Hover, press, chip and toggle changes."
      },
      "base": {
        "$type": "duration",
        "$value": "160ms",
        "$description": "Menus, popovers, tooltips."
      },
      "slow": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Side peek, drawers, toasts."
      },
      "deliberate": {
        "$type": "duration",
        "$value": "280ms",
        "$description": "Dialogs and route transitions."
      },
      "reduced": {
        "$type": "duration",
        "$value": "80ms",
        "$description": "Opacity fade that replaces movement under prefers-reduced-motion."
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0.0, 0.0, 1.0],
        "$description": "Moving within the screen."
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": [0.0, 0.0, 0.2, 1.0],
        "$description": "Elements appearing."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [0.4, 0.0, 1.0, 1.0],
        "$description": "Elements leaving."
      }
    },
    "spring": {
      "default": {
        "$type": "string",
        "$value": "damping 20 stiffness 220 mass 1",
        "$description": "Sheets and cards."
      },
      "snappy": {
        "$type": "string",
        "$value": "damping 26 stiffness 320 mass 1",
        "$description": "Buttons, toggles, scan confirmation."
      },
      "gentle": {
        "$type": "string",
        "$value": "damping 18 stiffness 140 mass 1",
        "$description": "Shared-element transitions."
      }
    }
  },
  "font": {
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$description": "Body text, inputs, table cells."

  "icon": {
    "size": {
      "12": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Inline with text-11."
      },
      "14": {
        "$type": "dimension",
        "$value": "14px",
        "$description": "Inside chips."
      },
      "16": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Web default. Lucide at 1.5 stroke."
      },
      "20": {
        "$type": "dimension",
        "$value": "20px",
        "$description": "Web large; Compass small."
      },
      "24": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Web extra large; Compass default."
      },
      "28": {
        "$type": "dimension",
        "$value": "28px",
        "$description": "Compass large: tab bar and ClockButton."
      }

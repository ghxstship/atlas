{
  "$description": "XOS Design System tokens in W3C Design Tokens (DTCG) format for packages/tokens. Generated from project/tokens.json; do not edit by hand. Spec names from Build Prompt Section 11.3.",
  "space": {
    "2": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Hairline gaps: icon to badge, chip inner offsets."
    },
    "4": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Gap inside chips; tight icon and label pairs."
    },
    "6": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Chip horizontal padding; icon to label in buttons."
    },
    "8": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Control horizontal padding; gaps between chips."
    },
    "12": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Row horizontal padding; gaps in toolbars."
    },
    "16": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Card padding; grid gutter below lg."
    },
    "20": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Side peek padding."
    },
    "24": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Page gutters; grid gutter from lg up."
    },
    "32": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "Section spacing on pages."
    },
    "40": {
      "$type": "dimension",
      "$value": "40px",
      "$description": "Empty and system state padding."
    },
    "48": {
      "$type": "dimension",
      "$value": "48px",
      "$description": "Large section breaks; Compass minimum touch target."
    },
    "64": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Page top spacing on Auth and System templates."
    }
  },
  "radius": {
    "chip": {
      "$type": "dimension",
      "$value": "4px",
      "$description": "Chips, tags, Kbd, checkboxes."
    },
    "control": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Inputs, buttons, segmented controls."
    },
    "card": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Cards, menus, popovers, toasts."
    },
    "dialog": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Dialogs and the command menu."
    },
    "mark": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Marks under 12 px: pips, legend swatches, milestone diamonds, small close buttons."
    },
    "pill": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Fully rounded ends: badges, filter chips, progress tracks, sliders, grabbers."
    },
    "widget": {
      "$type": "dimension",
      "$value": "22px",
      "$description": "iOS Live Activity and widget surfaces in Compass; matches the platform corner."
    },
    "device": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Phone frame for Compass previews in documentation only; never in product UI."
    }
  },
  "stroke": {
    "width": {
      "hairline": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "Every border and divider. Elevation is border-first."
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Focus rings, selected matrix cells and Sunlight control borders."
      },
      "accent": {
        "$type": "dimension",
        "$value": "3px",
        "$description": "Accent edges: Banner severity edge, live Run of Show cue, Payment Tracker steps."
      },
      "swatch": {
        "$type": "dimension",
        "$value": "4px",
        "$description": "Emergency code edge and the camera shutter ring."
      },
      "stripe": {
        "$type": "dimension",
        "$value": "12px",
        "$description": "Credential category stripe, readable at arm length."
      }
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.48,
      "$description": "Disabled controls."
    },
    "scrim-dark": {
      "$type": "number",
      "$value": 0.64,
      "$description": "Scrim behind dialogs in dark."
    },
    "scrim-light": {
      "$type": "number",
      "$value": 0.4,
      "$description": "Scrim behind dialogs in light."
    },
    "hover": {
      "$type": "number",
      "$value": 0.06,
      "$description": "Hover overlay on colored fills."
    },
    "pressed": {
      "$type": "number",
      "$value": 0.1,
      "$description": "Pressed overlay on colored fills."
    }
  },
  "z": {

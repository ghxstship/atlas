# Gateway server environment (validated at boot by apps/gateway/lib/env.ts).
# Copy to apps/gateway/.env.local. Never commit real keys; .env.* files other than this one are ignored.
#
# Local values target the shared xos4-shared Supabase stack (ports 560xx). `supabase status` in the
# shared-db worktree prints the anon key; it is the publishable key, guarded by RLS.

SUPABASE_URL=http://127.0.0.1:56021
SUPABASE_ANON_KEY=
GATEWAY_SITE_URL=http://127.0.0.1:3001

# Optional: hosts that serve the platform Gateway; every other host is an org's custom domain.
# GATEWAY_PLATFORM_HOSTS=127.0.0.1,localhost

# Optional, development and end-to-end tests only: the Supabase Auth email testing inbox.
SUPABASE_INBUCKET_URL=http://127.0.0.1:56024

# Continue on another device (ADR 0030): universal links to Compass. The owner sets these once the
# production domains and the Apple and Android signing identities are chosen; unset, QR codes carry
# compass:// links and /.well-known/apple-app-site-association and assetlinks.json answer 404.
# COMPASS_APPLE_TEAM_IDS=ABCDE12345
# COMPASS_ANDROID_CERT_SHA256=AA:BB:...

# Security keys as a second factor (Section 9): the WebAuthn relying party, matching supabase/config.toml
# [auth.webauthn]. WebAuthn needs a domain, so open Gateway at http://localhost:3001, not 127.0.0.1, to use
# passkeys and security keys locally. Production: ghxstship.tech with the https origins of Atlas and Gateway.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3001

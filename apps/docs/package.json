{
  "name": "@xos/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The XOS developer documentation site: guides, the API reference generated from OpenAPI, the help center and the self-hosting guide.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "dictionary:generate": "node --experimental-strip-types --no-warnings scripts/generate-data-dictionary.ts",
    "dictionary:check": "node --experimental-strip-types --no-warnings scripts/generate-data-dictionary.ts --check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@xos/i18n": "workspace:*",
    "@xos/icons": "workspace:*",
    "@xos/tokens": "workspace:*",
    "@xos/ui": "workspace:*",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xos/config": "workspace:*",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}

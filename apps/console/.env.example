# XOS Console server environment (validated at boot by apps/console/lib/env.ts).
# Copy to apps/console/.env.local. Never commit real keys; .env.* files other than this one are ignored.
#
# The console uses the same Supabase project as Atlas and Gateway and only its anon (publishable) key: every
# console action runs as the signed-in operator, and the database checks the operator, the role and the second
# factor (migration 1470). The service role key never belongs here.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
CONSOLE_SITE_URL=http://127.0.0.1:3390

# Optional: "false" hides the password form so the platform team signs in with Google only (ADR 0046). Defaults
# to showing it, which local development and the end-to-end journeys use.
# CONSOLE_PASSWORD_SIGN_IN=false

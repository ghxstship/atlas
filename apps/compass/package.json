{
  "name": "@xos/compass",
  "version": "0.0.0",
  "private": true,
  "description": "Compass 4.0: the field app for internal members and every external role type, offline first.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run --coverage",
    "generate:navigation": "XOS_WRITE_GENERATED=1 vitest run test/navigation.test.ts",
    "generate:help": "XOS_WRITE_GENERATED=1 vitest run test/help.test.ts",
    "e2e": "maestro test .maestro",
    "store:preflight": "node --experimental-strip-types --no-warnings scripts/store-preflight.ts",
    "release:ios": "node --experimental-strip-types --no-warnings scripts/store-preflight.ts ios && eas build --platform ios --profile production --auto-submit",
    "release:android": "node --experimental-strip-types --no-warnings scripts/store-preflight.ts android && eas build --platform android --profile production --auto-submit",
    "store:metadata": "node --experimental-strip-types --no-warnings scripts/store-preflight.ts metadata && eas metadata:push --profile production",
    "tenant:profile": "node --experimental-strip-types --no-warnings scripts/tenant-profile.ts",
    "tenant:check": "node --experimental-strip-types --no-warnings scripts/tenant-profile.ts --check"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@op-engineering/op-sqlite": "18.2.5",
    "@powersync/react-native": "2.3.1",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@supabase/supabase-js": "2.117.3",
    "@xos/ai": "workspace:*",
    "@xos/data": "workspace:*",
    "@xos/help": "workspace:*",
    "@xos/i18n": "workspace:*",
    "@xos/ia": "workspace:*",
    "@xos/sync": "workspace:*",
    "@xos/tokens": "workspace:*",
    "@xos/ui-native": "workspace:*",
    "@xos/workforce-native": "workspace:*",
    "expo": "57.0.27",
    "expo-audio": "57.0.5",
    "expo-brightness": "57.0.2",
    "expo-camera": "57.0.6",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.4",
    "expo-file-system": "57.0.7",
    "expo-haptics": "57.0.3",
    "expo-image-manipulator": "57.0.21",
    "expo-keep-awake": "57.0.2",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-location": "57.0.21",
    "expo-network": "57.0.2",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-updates": "57.0.25",
    "i18next": "26.4.2",
    "lucide-react-native": "1.53.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.3",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@xos/config": "workspace:*",
    "eas-cli": "24.12.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "op-sqlite": {
    "sqlcipher": true
  }
}

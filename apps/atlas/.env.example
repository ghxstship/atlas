# Atlas server environment (validated at boot by apps/atlas/lib/env.ts).
# Copy to apps/atlas/.env.local. Never commit real keys; .env.* files other than this one are ignored.
#
# Local values target the 554xx Supabase stack in supabase/config.toml (project id xos4).
# `supabase start` prints the anon key; it is the publishable key, guarded by RLS.

SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
ATLAS_SITE_URL=http://127.0.0.1:3000
# Public origin of Gateway, so advance and signing links show in full. The owner sets it on Vercel.
GATEWAY_SITE_URL=http://127.0.0.1:3001

# Optional, development and end-to-end tests only: the Supabase Auth email testing inbox.
SUPABASE_INBUCKET_URL=http://127.0.0.1:55424

# Continue on another device (ADR 0030): universal links to Compass. The owner sets these once the
# production domains and the Apple and Android signing identities are chosen; unset, QR codes carry
# compass:// links and /.well-known/apple-app-site-association and assetlinks.json answer 404.
# COMPASS_APPLE_TEAM_IDS=ABCDE12345
# COMPASS_ANDROID_CERT_SHA256=AA:BB:...

# Trusted proxies in front of the one that appends the client address to X-Forwarded-For (A69-003).
# Unset on Vercel and behind one reverse proxy; 1 behind a CDN and a proxy. The IP allow-list uses it.
# XOS_TRUSTED_PROXY_HOPS=1

# Optional: the API host (RRR-119). On this host Atlas serves only the public API, at /v1 instead of
# /api/v1; every page path answers 404 and no cookie is set. Production: api.ghxstship.tech.
# For local checks, api.localhost reaches 127.0.0.1 in browsers: http://api.localhost:3000/v1/...
# XOS_API_HOST=api.localhost

# Optional: the public origin of the docs site, for help center and API reference links.
# Production: https://docs.ghxstship.tech. Locally, `pnpm --filter @xos/docs dev` serves port 3004.
# DOCS_SITE_URL=http://127.0.0.1:3004

# Optional: the domain project inbox mail is received on (Section 4.6.5), the same value as the
# inbound-email Edge Function's XOS_INBOUND_DOMAIN. Its MX records point at the mail provider that
# posts to that function. Unset, project inboxes show only their local part.
# XOS_INBOUND_DOMAIN=inbound.example.com

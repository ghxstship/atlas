# Atlas server environment (validated at boot by apps/atlas/lib/env.ts).
# Copy to apps/atlas/.env.local. Never commit real keys; .env.* files other than this one are ignored.
#
# Local values target the 554xx Supabase stack in supabase/config.toml (project id xos4).
# `supabase start` prints the anon key; it is the publishable key, guarded by RLS.

SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_ANON_KEY=
ATLAS_SITE_URL=http://127.0.0.1:3000
# Public origin of Gateway, so advance and signing links show in full. The owner sets it on Vercel.
GATEWAY_SITE_URL=http://127.0.0.1:3001

# Optional, development and end-to-end tests only: the Supabase Auth email testing inbox.
SUPABASE_INBUCKET_URL=http://127.0.0.1:55424

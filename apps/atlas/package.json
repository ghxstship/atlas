{
  "name": "@xos/atlas",
  "version": "0.0.0",
  "private": true,
  "description": "Atlas 4.0: the internal web app and the public API at /api/v1.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate:routes": "XOS_WRITE_GENERATED=1 vitest run test/routes.test.ts",
    "e2e": "playwright test",
    "test:a11y": "playwright test -c e2e/a11y/playwright.a11y.config.ts"
  },

{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "ATLAS_SITE_URL",
        "GATEWAY_SITE_URL",
        "SUPABASE_INBUCKET_URL",
        "COMPASS_APPLE_TEAM_IDS",
        "COMPASS_ANDROID_CERT_SHA256",
        "WEBAUTHN_RP_ID",
        "WEBAUTHN_RP_ORIGINS",
        "VERCEL_GIT_COMMIT_SHA"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/legal/index.yaml",
        "$TURBO_ROOT$/packages/schemas/plans.yaml",
        "!e2e/**",
        "!test-results/**"
      ]
    }
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["SUPABASE_URL", "SUPABASE_ANON_KEY", "ATLAS_SITE_URL", "SUPABASE_INBUCKET_URL"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/legal/index.yaml",
        "$TURBO_ROOT$/packages/schemas/plans.yaml",
        "!e2e/**",
        "!test-results/**"
      ]
    }
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/data/src/database.types.ts",
        "$TURBO_ROOT$/packages/schemas/src/capabilities/codes.generated.ts"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/**",
        "$TURBO_ROOT$/packages/data/src/database.types.ts",
        "$TURBO_ROOT$/legal/**",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/packages/i18n/messages/**",
        "$TURBO_ROOT$/packages/schemas/*.yaml",
        "$TURBO_ROOT$/docs/adr/denormalization-register.*",
        "$TURBO_ROOT$/apps/compass/ia/**"
      ],
      "outputs": []
    },
    "storybook:build": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "test:visual": {
      "dependsOn": ["storybook:build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*", "VISUAL_UPDATE_SNAPSHOTS", "STORYBOOK_PORT"]
    }
  }
}
